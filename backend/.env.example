# Copy to .env for local development — never commit a real .env
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/boutique
# Staging/production only — owner-role URL, used ONLY by the release-phase
# `alembic upgrade head` step. Runtime services must never receive this under
# DATABASE_URL (verify_database_role refuses to boot on an owner connection).
# MIGRATIONS_DATABASE_URL=
APP_VERSION=0.1.0
APP_ENV=dev
BASE_DOMAIN=localtest.me
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
SESSION_TTL_SECONDS=43200
# Exactly one proxy hop (Railway) between the client and the app.
TRUST_FORWARDED_FOR=false
# Media storage. Left unset (not empty) the catalog is fully usable and only the
# upload endpoints answer 503 MEDIA_NOT_CONFIGURED. AWS credentials are NOT
# settings — boto3 reads AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY from the
# environment, so they never enter the config object. Never commit either here.
# MEDIA_BUCKET=
MEDIA_REGION=il-central-1
# MEDIA_ENDPOINT_URL and MEDIA_FORCE_PATH_STYLE are the MinIO / S3-compatible
# seam and must stay unset and false against real AWS (the app refuses to boot).
# MEDIA_ENDPOINT_URL=
MEDIA_FORCE_PATH_STYLE=false
MEDIA_PRESIGN_MAX_PER_WINDOW=60
MEDIA_PRESIGN_WINDOW_SECONDS=300
# Per-TENANT budget on the anonymous /storefront reads — a runaway brake, not a
# defence. Sized so it cannot fire on organic traffic: a first paint is 2
# requests, so 6000/60s is ~3000 first-paints per minute per boutique. Per-IP
# keying needs a trusted proxy chain and is owned by the F21 hardening gate.
STOREFRONT_READ_MAX_PER_WINDOW=6000
STOREFRONT_READ_WINDOW_SECONDS=60
# SMS. Unset (not empty) means UnconfiguredSmsSender: OTP send answers 503
# SMS_NOT_CONFIGURED and bookings are structurally gated on it — a supported
# deployment state, not a bug. `fake` is the in-memory outbox and is a BOOT
# FAILURE in production. `twilio` sends for real — money and real handsets, so
# it is opt-in per environment and dev/staging stay on `fake`.
# SMS_PROVIDER=fake
# Twilio credentials ARE settings, unlike the AWS pair in the media block above:
# boto3 reads the process environment itself, but this adapter is hand-written
# and nothing else reads these names, so they have to be fields to be seen at
# all. Set them HERE or as real process env vars — pydantic-settings reads both
# (Railway uses the latter, and a real env var wins over this file). They are
# SecretStr, so they never render into a repr, a log line or a traceback.
# All four are required: any one missing means OTP send answers 503
# SMS_NOT_CONFIGURED rather than erroring on every message. TWILIO_FROM_NUMBER
# is the E.164 number itself, NOT the PN… resource SID; the API key pair
# authenticates but names no account, which is why the account SID is separate.
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_FROM_NUMBER=
# Payments. Unset means every gateway route answers 503 GATEWAY_NOT_CONFIGURED.
# `fake` is F17's in-memory adapter (real HMAC, fake sessions) and is a BOOT
# FAILURE in production. `lemonsqueezy` arrives with F18 and is TEST MODE ONLY —
# Lemon Squeezy is merchant-of-record and cannot carry a boutique's deposit
# money; the production Israeli PSP is an unmade decision (see
# .planning/external-applications.md row 3).
# PAYMENT_PROVIDER=fake
#
# There are deliberately NO LEMONSQUEEZY_* variables here, unlike TWILIO_*
# above. Gateway credentials are PER TENANT (D5): each boutique's api_key,
# store_id, variant_id and webhook_secret are typed into her own console, sent
# once, encrypted through the SecretBox and stored as ciphertext on
# tenant_gateway_credentials. Nothing reads them from the environment, so an
# operator setting them here would configure nothing.
#
# `variant_id` is the placeholder variant the checkout rides on — LS's checkout
# API is a product-catalog one and requires a variant, while a deposit is an
# arbitrary amount, so every checkout overrides its price with custom_price.
# Create it by hand in the LS dashboard; its price is never used.
