# Copy to .env for local development — never commit a real .env
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/boutique
APP_VERSION=0.1.0
APP_ENV=dev
BASE_DOMAIN=localtest.me
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
SESSION_TTL_SECONDS=43200
# Media storage. Left unset (not empty) the catalog is fully usable and only the
# upload endpoints answer 503 MEDIA_NOT_CONFIGURED. AWS credentials are NOT
# settings — boto3 reads AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY from the
# environment, so they never enter the config object. Never commit either here.
# MEDIA_BUCKET=
MEDIA_REGION=il-central-1
# MEDIA_ENDPOINT_URL and MEDIA_FORCE_PATH_STYLE are the MinIO / S3-compatible
# seam and must stay unset and false against real AWS (the app refuses to boot).
# MEDIA_ENDPOINT_URL=
MEDIA_FORCE_PATH_STYLE=false
MEDIA_PRESIGN_MAX_PER_WINDOW=60
MEDIA_PRESIGN_WINDOW_SECONDS=300
# Per-TENANT budget on the anonymous /storefront reads — a runaway brake, not a
# defence. Sized so it cannot fire on organic traffic: a first paint is 2
# requests, so 6000/60s is ~3000 first-paints per minute per boutique. Per-IP
# keying needs a trusted proxy chain and is owned by the F21 hardening gate.
STOREFRONT_READ_MAX_PER_WINDOW=6000
STOREFRONT_READ_WINDOW_SECONDS=60
